# Extraction provider. If OPENROUTER_API_KEY is set, `radar` uses OpenRouter
# by default; override with --provider anthropic.
OPENROUTER_API_KEY=sk-or-...

# Used only with --provider anthropic
ANTHROPIC_API_KEY=

# Optional. Raises the GitHub API rate limit from 60 to 5000 requests/hour
# when reading release notes.
GITHUB_TOKEN=
